# Cabeceras de seguridad (las aplica Cloudflare Pages / Netlify en el dominio propio).
# GitHub Pages las ignora, pero no hacen daño; el objetivo es el despliegue final.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  X-DNS-Prefetch-Control: off
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' blob:; worker-src 'self' blob:; child-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

# Assets con hash → cache inmutable de 1 año (carga instantánea en repetición, en todo el mundo).
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Imágenes de portadas (estables) → cache larga.
/covers/*
  Cache-Control: public, max-age=2592000

/og.png
  Cache-Control: public, max-age=604800
